# ---------------------------------------------------------------------------
# echo-kid-assistant — environment template
#
# Copy to `.env.local` for local work. NEVER commit a filled-in copy:
# `.env` and `.env.local` are already in .gitignore.
#
# Full explanation of every variable: docs/ENV.md
# In production these are set in the Vercel project, not in a file.
# ---------------------------------------------------------------------------

# --- Required: the model calls -------------------------------------------

# Anthropic API key. Console -> Settings -> API keys.
# Placeholder only. Never paste a real key into a tracked file.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Model used for BOTH safety gates (input classifier + output rubric).
# Fast/cheap Haiku-class model. VERIFY against the current model list at
# deploy time — see docs/ENV.md "Model IDs".
MODEL_GATE=claude-haiku-4-5-20251001

# Model used for generation. Sonnet-class. VERIFY at deploy time.
MODEL_GEN=claude-sonnet-5

# --- Required: storage ----------------------------------------------------

# Neon Postgres pooled connection string.
# Neon Console -> project -> Connect -> copy (leave connection pooling on).
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# --- Required: parent review page ----------------------------------------

# Password for /api/parent. Long and random. If this is unset the parent page
# authenticates NOTHING (it compares against a random per-process value), so
# the page is unreachable rather than open — but set it.
PARENT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSPHRASE

# --- Recommended ----------------------------------------------------------

# Signing key for the parent session cookie. Defaults to PARENT_PASSWORD.
# Set it separately so that changing the password does not log you out
# everywhere, and so the password is not also the cookie key.
SESSION_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_STRING

# Alexa skill id (amzn1.ask.skill.xxxxxxxx-...). When set, the endpoint
# rejects requests from any other skill. Get it from the developer console
# or from .ask/ask-states.json after the first `ask deploy`.
ALEXA_SKILL_ID=amzn1.ask.skill.REPLACE_ME
