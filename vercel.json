{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 10,
      "includeFiles": "{src/prompts/**,config/**}"
    }
  },
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/parent",
      "destination": "/api/parent"
    },
    {
      "source": "/parent/login",
      "destination": "/api/parent/login"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
